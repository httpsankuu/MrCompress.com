---
import Layout from '../layouts/Layout.astro';
import Optimizer from '../components/Optimizer';
---

<Layout 
	title="Convert Image Format Online - PNG, JPG, WebP, AVIF, PDF"
	description="Convert your images to different formats online for free. Support for WebP, AVIF, JPEG, PNG, and PDF conversion without server processing."
	keywords="convert image format, image converter, webp to jpg, png to webp, avif converter, image to pdf"
>
	<section class="relative overflow-hidden pt-16 pb-8 sm:pt-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
			<h1 class="text-4xl font-bold tracking-tight text-ink sm:text-6xl mb-4 max-w-4xl">
				Convert <span class="bg-gradient-to-r from-geist-link to-cyan-deep bg-clip-text text-transparent">File.</span>
			</h1>
			<p class="mx-auto max-w-2xl text-lg text-body mb-6 leading-relaxed">
				Switch between PNG, JPEG, WebP, AVIF, and PDF in seconds. No uploads required.
			</p>
		</div>
	</section>

	<section class="py-12">
		<Optimizer client:only="react" initialTab="convert" />
	</section>
</Layout>
