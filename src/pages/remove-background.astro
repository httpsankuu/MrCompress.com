---
import Layout from '../layouts/Layout.astro';
import Optimizer from '../components/Optimizer';
---

<Layout 
	title="Remove Image Background Online - Fast & Private"
	description="Remove background from any image instantly using AI. 100% private, browser-side processing. No uploads required."
>
	<section class="py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center mb-12">
			<h1 class="text-4xl font-bold tracking-tight text-ink sm:text-6xl mb-6">
				Background <span class="bg-gradient-to-r from-geist-link to-cyan-deep bg-clip-text text-transparent">Remover.</span>
			</h1>
			<p class="text-lg text-mute max-w-2xl mx-auto">
				Use powerful AI to strip backgrounds in seconds. Completely private processing that happens directly in your browser.
			</p>
		</div>

		<Optimizer client:only="react" initialTab="remove-bg" allowedTabs={['remove-bg']} showRemoveBg={true} />
	</section>
</Layout>
