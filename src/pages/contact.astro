---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Contact Us - Image Optimizer"
	description="Have questions or feedback? Contact the Image Optimizer team. We are here to help you with your image optimization needs."
>
	<section class="py-24">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<h1 class="text-4xl font-bold tracking-tight text-ink mb-8">Contact Us</h1>
			<div class="prose prose-sm text-body leading-relaxed">
				<p class="mb-8">
					We value your feedback and are here to help with any questions you may have about Image Optimizer. Whether you've found a bug, have a feature request, or just want to say hello, feel free to reach out.
				</p>

				<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 mt-12">
					<div class="p-6 rounded-geist border border-hairline bg-canvas shadow-v-1">
						<h2 class="text-lg font-bold text-ink mb-2">Email Support</h2>
						<p class="text-sm text-body mb-4">For general inquiries and support, email us at:</p>
						<a href="mailto:support@imageoptmize.com" class="text-geist-link font-medium hover:underline">support@imageoptmize.com</a>
					</div>
					<div class="p-6 rounded-geist border border-hairline bg-canvas shadow-v-1">
						<h2 class="text-lg font-bold text-ink mb-2">Feedback</h2>
						<p class="text-sm text-body mb-4">Want to suggest a feature? Use our feedback tool or email:</p>
						<a href="mailto:feedback@imageoptmize.com" class="text-geist-link font-medium hover:underline">feedback@imageoptmize.com</a>
					</div>
				</div>

				<h2 class="text-xl font-bold text-ink mt-12 mb-4">Response Time</h2>
				<p class="mb-4">
					We aim to respond to all inquiries within 24-48 hours. Please provide as much detail as possible so we can better assist you.
				</p>
			</div>
		</div>
	</section>
</Layout>
