---
import Layout from '../layouts/Layout.astro';
import Optimizer from '../components/Optimizer';
import Hero from '../components/Hero';
import FAQ from '../components/FAQ';
import ErrorBoundary from '../components/ErrorBoundary';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How to compress an image?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To compress an image, simply drag and drop your file into our optimizer. Adjust the quality slider to find the perfect balance between file size and clarity, then click the download button. Everything happens locally in your browser for maximum privacy."
      }
    },
    {
      "@type": "Question",
      "name": "How to compress image size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can compress image size by reducing the quality percentage or by resizing the image's pixel dimensions. Our tool shows you a live preview of the final file size so you can achieve the exact optimization you need."
      }
    },
    {
      "@type": "Question",
      "name": "How to compress image on iPhone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To compress an image on an iPhone, open our website in Safari, upload a photo from your library, adjust the settings as needed, and save the optimized image directly back to your Photos app. No extra apps required."
      }
    },
    {
      "@type": "Question",
      "name": "How to compress image without losing quality?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To compress an image without losing quality, use our advanced algorithms that remove unnecessary metadata and redundant pixel data. While 'lossless' compression is available, even our 'lossy' settings are designed to be visually indistinguishable from the original."
      }
    },
    {
      "@type": "Question",
      "name": "How to compress image file size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Reducing image file size is easy: select your file, choose a modern format like WebP or AVIF for better compression ratios, and lower the quality slider until you reach your target size."
      }
    },
    {
      "@type": "Question",
      "name": "How to compress an image on Mac?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On a Mac, you can compress an image by using our online tool in any browser. It's a faster alternative to using built-in tools like Preview, especially when you need to convert formats or target specific file sizes."
      }
    },
    {
      "@type": "Question",
      "name": "Compress image to 20kb?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To compress an image to 20kb, you may need to reduce the dimensions (width and height) and lower the quality setting. Our real-time size counter helps you see exactly when you've reached the 20kb threshold."
      }
    }
  ]
};
---

<Layout 
	title="MrCompress - Fast, Secure & Free Online Image Optimizer"
	description="Compress and convert images online without losing quality. Support for PNG, JPG, WebP, AVIF, HEIC and PDF. All processing happens locally in your browser."
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
	<Hero client:only="react" />

	<section id="tool" class="pb-24">
		<ErrorBoundary client:only="react">
			<Optimizer client:only="react" />
		</ErrorBoundary>
	</section>

	<section class="py-24 border-t border-hairline bg-canvas-soft/30">
		<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="text-3xl font-bold text-ink mb-8">Optimize Your Images with MrCompress</h2>
			<div class="max-w-3xl mx-auto text-body leading-relaxed space-y-6 text-lg">
				<p>
					In today's fast-paced digital world, speed is everything. High-resolution images are essential for capturing attention, but their large file sizes can slow down your website and consume valuable storage. <strong>MrCompress</strong> is designed to solve this problem by providing a fast, secure, and intuitive way to <strong>compress images</strong> without sacrificing quality.
				</p>
				<p>
					Our tool uses advanced algorithms to surgically remove redundant data, allowing you to <strong>compress image size</strong> to 100kb, 50kb, or even 20kb with ease. Whether you're optimizing for SEO, social media, or saving space on your iPhone, MrCompress handles everything locally in your browser. This means your private photos stay private and the processing is near-instant.
				</p>
				<p>
					From bulk conversion to precision cropping, we provide the features you need to maintain visual clarity while achieving maximum performance. Start optimizing today and see how a few kilobytes can make a massive difference.
				</p>
			</div>
		</div>
	</section>

	<FAQ client:only="react" />
</Layout>
