---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="500 - Server Error | Imagoptimize"
	description="Something went wrong on our end. Please try again later. Your privacy and images are still our priority."
>
	<section class="relative overflow-hidden pt-32 pb-24 min-h-[70vh] flex items-center">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<div class="inline-flex items-center justify-center p-3 mb-8 rounded-2xl bg-canvas border border-hairline shadow-v-2">
				<span class="text-4xl font-bold bg-gradient-to-r from-geist-link to-cyan-deep bg-clip-text text-transparent">500</span>
			</div>
			<h1 class="text-4xl font-bold tracking-tight text-ink sm:text-6xl mb-6">
				Something went wrong.
			</h1>
			<p class="mx-auto max-w-xl text-lg text-body mb-10 leading-relaxed">
				We're experiencing an internal server error. This usually happens when our tools are under heavy load or maintenance. Please try refreshing the page or come back in a few minutes.
			</p>
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<button onclick="window.location.reload()" class="flex items-center justify-center gap-2 rounded-geist-pill bg-ink px-8 py-3 text-sm font-semibold text-canvas shadow-v-4 transition-all hover:opacity-90 w-full sm:w-auto">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
					Refresh Page
				</button>
				<a href="/" class="flex items-center justify-center gap-2 rounded-geist-pill border border-hairline bg-canvas px-8 py-3 text-sm font-semibold text-ink shadow-v-1 transition-all hover:bg-canvas-soft w-full sm:w-auto">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-home"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
					Back to Home
				</a>
			</div>
		</div>
	</section>
</Layout>
