---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="404 - Page Not Found | Imagoptimize"
	description="The page you are looking for doesn't exist. Return to Imagoptimize to compress and convert your images for free."
>
	<section class="relative overflow-hidden pt-32 pb-24 min-h-[70vh] flex items-center">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<div class="inline-flex items-center justify-center p-3 mb-8 rounded-2xl bg-canvas border border-hairline shadow-v-2">
				<span class="text-4xl font-bold bg-gradient-to-r from-geist-link to-cyan-deep bg-clip-text text-transparent">404</span>
			</div>
			<h1 class="text-4xl font-bold tracking-tight text-ink sm:text-6xl mb-6">
				Lost in space?
			</h1>
			<p class="mx-auto max-w-xl text-lg text-body mb-10 leading-relaxed">
				We couldn't find the page you're looking for. It might have been moved or deleted, but don't worry—your images are still safe with you.
			</p>
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="/" class="flex items-center gap-2 rounded-geist-pill bg-ink px-8 py-3 text-sm font-semibold text-canvas shadow-v-4 transition-all hover:opacity-90 w-full sm:w-auto">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-home"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
					Back to Home
				</a>
				<a href="/compress" class="flex items-center gap-2 rounded-geist-pill border border-hairline bg-canvas px-8 py-3 text-sm font-semibold text-ink shadow-v-1 transition-all hover:bg-canvas-soft w-full sm:w-auto">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-horizontal"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>
					Compress Image
				</a>
			</div>
		</div>
	</section>
</Layout>
