								<div class="grid grid-cols-1 gap-0.5 max-h-64 overflow-y-auto scrollbar-thin scrollbar-thumb-hairline" id="lang-options">
									<button data-lang="en" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										English <span>🇺🇸</span>
									</button>
