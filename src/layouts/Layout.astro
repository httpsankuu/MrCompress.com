---
import "../styles/global.css";
import ToasterProvider from "../components/ToasterProvider";
import LanguageSelector from "../components/LanguageSelector";

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogType?: string;
}

const { 
	title, 
	description = "Compress images online for free without losing quality. Optimize image size to 100kb, 50kb, or 20kb easily with our secure, local MrCompress.",
	keywords = "compress image, compress image size, compress image online, compress image file, compress image free, compress image without losing quality",
	ogImage = "/social-share.png",
	ogType = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://mrcompress.pages.dev");
const supportedLanguages = ['en', 'es', 'zh', 'hi', 'ar', 'fr', 'pt', 'ru', 'ja', 'de'];

const getHreflangUrl = (lang: string) => {
	const url = new URL(Astro.url.pathname, Astro.site || "https://mrcompress.pages.dev");
	url.searchParams.set('lang', lang);
	return url.toString();
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "MrCompress",
      "url": "https://mrcompress.pages.dev",
      "logo": "https://mrcompress.pages.dev/favicon-96x96.png"
    },
    {
      "@type": "SoftwareApplication",
      "name": "MrCompress",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MrCompress" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Theme Color -->
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(ogImage, Astro.url)} />

		<!-- Hreflang Tags -->
		{supportedLanguages.map(lang => (
			<link rel="alternate" hreflang={lang} href={getHreflangUrl(lang)} />
		))}
		<link rel="alternate" hreflang="x-default" href={getHreflangUrl('en')} />

		<!-- JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />

		<!-- Analytics -->
		<script defer data-domain="mrcompress.pages.dev" src="https://plausible.io/js/script.js"></script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		<script is:inline>
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};

			const applyTheme = (theme) => {
				if (theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
				localStorage.setItem('theme', theme);
			};

			window.toggleTheme = () => {
				const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
				const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
				applyTheme(newTheme);
			};

			// Initial sync
			applyTheme(getTheme());

			// Sync after navigation
			document.addEventListener('astro:after-swap', () => applyTheme(getTheme()));
		</script>
		<slot name="head" />
	</head>
	<body class="selection:bg-ink selection:text-canvas relative overflow-x-hidden min-h-screen">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-ink focus:text-canvas focus:rounded-geist focus:font-semibold focus:shadow-v-4">
			Skip to main content
		</a>
		<ToasterProvider client:only="react" />
		<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none bg-canvas-soft">
			<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] blur-[120px] rounded-full animate-blob-1 gemini-gradient-1 opacity-80"></div>
			<div class="absolute bottom-[10%] right-[-5%] w-[35%] h-[35%] blur-[100px] rounded-full animate-blob-2 gemini-gradient-2 opacity-70"></div>
			<div class="absolute top-[20%] right-[10%] w-[30%] h-[30%] blur-[80px] rounded-full animate-blob-3 gemini-gradient-3 opacity-60"></div>
		</div>
		<nav class="sticky top-0 z-50 h-16 border-b border-hairline bg-canvas/80 backdrop-blur-md">
			<div class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
				<a href="/" class="flex items-center gap-2">
					<img src="/favicon-96x96.png" alt="Logo" class="h-6 w-6 rounded-sm" loading="eager" />
					<span class="text-sm font-semibold tracking-tight text-ink">MrCompress</span>
				</a>
				<div class="flex items-center gap-6">
					<div class="hidden md:flex items-center gap-3">
						<a href="/compress" class="flex items-center gap-1.5 px-3 py-1.5 rounded-geist bg-ink text-canvas hover:opacity-90 transition-all text-xs font-semibold shadow-v-2">
							Compress
						</a>
						<a href="/convert" class="flex items-center gap-1.5 px-3 py-1.5 rounded-geist border border-hairline bg-canvas text-ink hover:bg-canvas-soft transition-all text-xs font-semibold shadow-v-1">
							Convert
						</a>
						<a href="/social" class="text-xs font-medium text-mute hover:text-ink transition-colors px-1">Social Resizer</a>
						<div class="w-px h-4 bg-hairline mx-2"></div>
						<a href="/about" class="text-xs font-medium text-mute hover:text-ink transition-colors px-1">About</a>
					</div>
					<div class="h-4 w-px bg-hairline hidden md:block"></div>
					<div class="flex items-center gap-3">
						<LanguageSelector client:only="react" />
						
						<button 
							id="theme-toggle"
							onclick="window.toggleTheme()"
							class="flex h-8 w-8 items-center justify-center rounded-geist border border-hairline bg-canvas text-ink shadow-v-1 transition-all hover:bg-canvas-soft-2"
							aria-label="Toggle dark mode"
						>
							<svg id="sun-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1m-16 0H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
							</svg>
							<svg id="moon-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
							</svg>
						</button>
						<!-- Mobile Menu Button -->
						<button 
							id="mobile-menu-button"
							class="flex md:hidden h-8 w-8 items-center justify-center rounded-geist border border-hairline bg-canvas text-ink shadow-v-1 transition-all hover:bg-canvas-soft-2"
							aria-label="Toggle Menu"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
						</button>
					</div>
				</div>
			</div>
		</nav>

		<!-- Mobile Menu Overlay -->
		<div id="mobile-menu" class="fixed inset-0 z-[100] hidden bg-canvas/95 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-200">
			<div class="flex flex-col h-full p-6">
				<div class="flex items-center justify-between mb-12">
					<a href="/" class="flex items-center gap-2">
						<img src="/favicon-96x96.png" alt="Logo" class="h-6 w-6 rounded-sm" loading="lazy" />
						<span class="text-sm font-semibold tracking-tight text-ink">MrCompress</span>
					</a>
					<button id="close-mobile-menu" class="h-8 w-8 flex items-center justify-center rounded-geist border border-hairline bg-canvas text-ink">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
					</button>
				</div>
				<nav class="flex flex-col gap-4">
					<a href="/compress" class="flex items-center justify-between px-6 py-4 rounded-2xl bg-ink text-canvas font-bold shadow-v-4">
						Compress Image
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-horizontal"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>
					</a>
					<a href="/convert" class="flex items-center justify-between px-6 py-4 rounded-2xl border border-hairline bg-canvas text-ink font-bold shadow-v-2">
						Convert Format
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-left"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>
					</a>
					<a href="/social" class="flex items-center justify-between px-6 py-4 rounded-2xl border border-hairline bg-canvas text-ink font-bold shadow-v-2">
						Social Resizer
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share-2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
					</a>
					<div class="h-px bg-hairline my-4"></div>
					<a href="/about" class="px-6 py-3 text-lg font-medium text-mute hover:text-ink">About Us</a>
					<a href="/privacy" class="px-6 py-3 text-lg font-medium text-mute hover:text-ink">Privacy Policy</a>
				</nav>
			</div>
		</div>

		<script is:inline>
			// Language Logic
			const initLang = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('i18nextLng')) {
					return localStorage.getItem('i18nextLng');
				}
				return 'en';
			})();
			
			if (initLang) {
				const shortLang = initLang.split('-')[0];
				document.documentElement.lang = shortLang;
				document.documentElement.dir = shortLang === 'ar' ? 'rtl' : 'ltr';
			}

			// Mobile Menu Logic
			const mobileMenuButton = document.getElementById('mobile-menu-button');
			const mobileTabMenuButton = document.getElementById('mobile-tab-menu');
			const closeMobileMenuButton = document.getElementById('close-mobile-menu');
			const mobileMenu = document.getElementById('mobile-menu');

			const setupMobileMenu = () => {
				if (mobileMenu && closeMobileMenuButton) {
					const focusableElements = mobileMenu.querySelectorAll('a[href], button, textarea, input[type="text"], input[type="radio"], input[type="checkbox"], select');
					const firstFocusableElement = focusableElements[0];
					const lastFocusableElement = focusableElements[focusableElements.length - 1];

					const closeMenu = () => {
						mobileMenu.classList.add('hidden');
						document.body.style.overflow = '';
						if (mobileMenuButton) mobileMenuButton.focus();
					};

					const openMenu = () => {
						mobileMenu.classList.remove('hidden');
						document.body.style.overflow = 'hidden';
						if (firstFocusableElement) (firstFocusableElement as HTMLElement).focus();
					};

					if (mobileMenuButton) mobileMenuButton.addEventListener('click', openMenu);
					if (mobileTabMenuButton) mobileTabMenuButton.addEventListener('click', openMenu);

					closeMobileMenuButton.addEventListener('click', closeMenu);

					mobileMenu.addEventListener('keydown', (e) => {
						if (e.key === 'Escape') closeMenu();
						if (e.key === 'Tab') {
							if (e.shiftKey) {
								if (document.activeElement === firstFocusableElement) {
									(lastFocusableElement as HTMLElement).focus();
									e.preventDefault();
								}
							} else {
								if (document.activeElement === lastFocusableElement) {
									(firstFocusableElement as HTMLElement).focus();
									e.preventDefault();
								}
							}
						}
					});

					// Close on link click
					mobileMenu.querySelectorAll('a').forEach(link => {
						link.addEventListener('click', closeMenu);
					});
				}
			}
			setupMobileMenu();
			document.addEventListener('astro:after-swap', setupMobileMenu);

			// Active Link Logic
			const setupActiveLinks = () => {
				const currentPath = window.location.pathname;
				
				// Standard nav links
				document.querySelectorAll('nav a').forEach(link => {
					const href = link.getAttribute('href');
					if (href === currentPath && currentPath !== '/') {
						link.setAttribute('aria-current', 'page');
						link.classList.add('opacity-100');
						link.classList.add('text-ink');
						link.classList.remove('text-mute');
					} else if (href === '/' && currentPath === '/') {
						link.setAttribute('aria-current', 'page');
					}
				});

				// Bottom tab specific active state
				document.querySelectorAll('[data-nav-link]').forEach(link => {
					if (link.getAttribute('href') === currentPath) {
						link.classList.add('text-ink');
						link.classList.remove('text-mute');
						// Add a small active indicator if needed, but text color change is often enough
					}
				});
			}
			setupActiveLinks();
			document.addEventListener('astro:after-swap', setupActiveLinks);
		</script>
		<main id="main-content" class="pb-24 md:pb-0 safe-area-bottom">
			<slot />
		</main>

		<!-- Mobile Bottom Tab Bar -->
		<nav class="fixed bottom-0 left-0 right-0 z-[60] h-16 bg-canvas/80 backdrop-blur-xl border-t border-hairline md:hidden safe-area-bottom">
			<div class="grid h-full grid-cols-4">
				<a href="/compress" class="flex flex-col items-center justify-center gap-1 text-mute hover:text-ink transition-colors" data-nav-link="/compress">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M12 2v10"/><path d="m9 9 3 3 3-3"/></svg>
					<span class="text-[10px] font-bold uppercase tracking-tighter">Compress</span>
				</a>
				<a href="/convert" class="flex flex-col items-center justify-center gap-1 text-mute hover:text-ink transition-colors" data-nav-link="/convert">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>
					<span class="text-[10px] font-bold uppercase tracking-tighter">Convert</span>
				</a>
				<a href="/social" class="flex flex-col items-center justify-center gap-1 text-mute hover:text-ink transition-colors" data-nav-link="/social">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
					<span class="text-[10px] font-bold uppercase tracking-tighter">Social</span>
				</a>
				<button id="mobile-tab-menu" class="flex flex-col items-center justify-center gap-1 text-mute hover:text-ink transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
					<span class="text-[10px] font-bold uppercase tracking-tighter">Menu</span>
				</button>
			</div>
		</nav>
		<footer class="border-t border-hairline bg-canvas py-16 mt-24">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
					<div class="col-span-1 md:col-span-2">
						<a href="/" class="flex items-center gap-2 mb-4">
							<img src="/favicon-96x96.png" alt="Logo" class="h-6 w-6 rounded-sm" loading="lazy" />
							<span class="text-sm font-semibold tracking-tight text-ink">MrCompress</span>
						</a>
						<p class="text-xs text-mute max-w-xs leading-relaxed">
							The fastest, most secure way to optimize your images. Everything happens locally in your browser. Private by design.
						</p>
					</div>
					<div>
						<h4 class="text-xs font-bold text-ink mb-4 uppercase tracking-wider">Product</h4>
						<ul class="space-y-3">
							<li><a href="/compress" class="text-xs text-mute hover:text-ink transition-colors">Compress Image</a></li>
							<li><a href="/convert" class="text-xs text-mute hover:text-ink transition-colors">Convert Format</a></li>
							<li><a href="/social" class="text-xs text-mute hover:text-ink transition-colors">Social Resizer</a></li>
							<li><a href="/learn" class="text-xs text-mute hover:text-ink transition-colors">Resource Hub</a></li>
							<li><a href="/#faq" class="text-xs text-mute hover:text-ink transition-colors">FAQs</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-xs font-bold text-ink mb-4 uppercase tracking-wider">Company</h4>
						<ul class="space-y-3">
							<li><a href="/about" class="text-xs text-mute hover:text-ink transition-colors">About Us</a></li>
							<li><a href="/privacy" class="text-xs text-mute hover:text-ink transition-colors">Privacy Policy</a></li>
							<li><a href="/terms" class="text-xs text-mute hover:text-ink transition-colors">Terms & Conditions</a></li>
						</ul>
					</div>
				</div>
				<div class="pt-8 border-t border-hairline flex flex-col items-center justify-between gap-6 sm:flex-row">
					<p class="text-[10px] uppercase tracking-widest text-mute font-medium">© {new Date().getFullYear()} mrcompress.com • All rights reserved.</p>
				</div>
			</div>
		</footer>
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(err => {
						console.error('ServiceWorker registration failed: ', err);
					});
				});
			}
		</script>
	</body>
</html>
