									</button>
									<button data-lang="pt" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										Português <span>🇵🇹</span>
									</button>
									<button data-lang="ar" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										العربية <span>🇸🇦</span>
									</button>
									<button data-lang="ru" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										Русский <span>🇷🇺</span>
									</button>
									<button data-lang="ko" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										한국어 <span>🇰🇷</span>
									</button>
									<button data-lang="it" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										Italiano <span>🇮🇹</span>
									</button>
									<button data-lang="tr" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										Türkçe <span>🇹🇷</span>
									</button>
									<button data-lang="vi" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										Tiếng Việt <span>🇻🇳</span>
									</button>
									<button data-lang="pl" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										Polski <span>🇵🇱</span>
									</button>
									<button data-lang="nl" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										Nederlands <span>🇳🇱</span>
									</button>
									<button data-lang="th" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										ไทย <span>🇹🇭</span>
									</button>
									<button data-lang="id" class="flex items-center justify-between px-3 py-1.5 rounded-sm hover:bg-canvas-soft text-[11px] text-mute hover:text-ink transition-colors w-full text-left">
										Bahasa Indonesia <span>🇮🇩</span>
									</button>
								</div>
							</div>
						</div>
						<!-- Hidden Original Widget -->
						<div id="google_translate_element" style="position: absolute; opacity: 0; pointer-events: none; z-index: -1;"></div>
						
						<button 
							id="theme-toggle"
							class="flex h-8 w-8 items-center justify-center rounded-geist border border-hairline bg-canvas text-ink shadow-v-1 transition-all hover:bg-canvas-soft-2 skiptranslate"
							aria-label="Toggle dark mode"
						>
							<svg id="sun-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1m-16 0H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
							</svg>
							<svg id="moon-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
							</svg>
						</button>
