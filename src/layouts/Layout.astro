---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogType?: string;
}

const { 
	title, 
	description = "Compress images online for free without losing quality. Optimize image size to 100kb, 50kb, or 20kb easily with our secure, local image ninja.",
	keywords = "compress image, compress image size, compress image online, compress image file, compress image free, compress image without losing quality",
	ogImage = "/favicon-96x96.png",
	ogType = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://imagninja.com");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Optimizer" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(ogImage, Astro.url)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		<slot name="head" />

		<!-- Google Translate Script -->
		<script type="text/javascript" is:inline>
			function googleTranslateElementInit() {
				new google.translate.TranslateElement({
					pageLanguage: 'en',
					layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
					autoDisplay: false
				}, 'google_translate_element');
			}
		</script>
		<script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" is:inline></script>

		<style is:global>
			/* Nuclear option to hide all Google Translate artifacts */
			.goog-te-banner-frame,
			.goog-te-banner,
			.goog-te-balloon-frame,
			.goog-te-menu-frame,
			iframe#\:1\.container,
			iframe#\:0\.container,
			iframe[id*=":1.container"],
			iframe[id*=":0.container"],
			iframe[id*=":2.container"],
			iframe.goog-te-banner-frame,
			iframe.goog-te-menu-frame,
			#goog-gt-tt,
			.goog-gt-tt,
			.goog-te-spinner-pos,
			.goog-te-spinner-pos *,
			.goog-te-spinner,
			.goog-te-spinner *,
			.goog-te-gadget-icon,
			.goog-logo-link,
			.skiptranslate[id*="goog-gt-tt"],
			.VIpgJm-Zp6pS-aZ2wYd-W79pY,
			.VIpgJm-Zp6pS-aZ2wYd-W79pY *,
			#google_translate_element img,
			.goog-te-menu-value img,
			.goog-te-gadget-simple img,
			.goog-te-gadget-icon {
				display: none !important;
				visibility: hidden !important;
				opacity: 0 !important;
				pointer-events: none !important;
				height: 0 !important;
				width: 0 !important;
				position: absolute !important;
				top: -9999px !important;
			}

			html, body {
				top: 0 !important;
				position: static !important;
			}


			/* Remove the highlight Google adds to translated text */
			.goog-text-highlight {
				background-color: transparent !important;
				box-shadow: none !important;
				border: none !important;
			}

			/* Ensure our custom UI remains visible and centered */
			#theme-toggle.skiptranslate {
				display: flex !important;
			}
			.skiptranslate {
				visibility: visible !important;
			}




			.goog-te-gadget-simple {
				background-color: transparent !important;
				border: 1px solid var(--hairline) !important;
				padding: 4px 8px !important;
				border-radius: 6px !important;
				font-size: 12px !important;
				font-family: 'Inter', sans-serif !important;
				display: flex !important;
				align-items: center !important;
				gap: 4px !important;
				cursor: pointer !important;
				transition: all 0.2s !important;
			}
			.goog-te-gadget-simple:hover {
				background-color: var(--canvas-soft) !important;
			}
			.goog-te-menu-value {
				color: var(--ink) !important;
				display: flex !important;
				align-items: center !important;
				gap: 4px !important;
			}
			.goog-te-menu-value span {
				border-left: none !important;
			}
			.goog-te-menu-value img {
				display: none !important;
			}
			/* Dark mode adjustments for Google Translate */
			.dark .goog-te-gadget-simple {
				border-color: #333 !important;
				background-color: #111 !important;
			}
			.dark .goog-te-menu-value {
				color: #eee !important;
			}
		</style>
	</head>
	<body class="selection:bg-ink selection:text-canvas relative overflow-x-hidden min-h-screen">
		<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none bg-canvas-soft">
			<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] blur-[120px] rounded-full animate-blob-1 gemini-gradient-1 opacity-80"></div>
			<div class="absolute bottom-[10%] right-[-5%] w-[35%] h-[35%] blur-[100px] rounded-full animate-blob-2 gemini-gradient-2 opacity-70"></div>
