---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class="selection:bg-ink selection:text-canvas">
		<nav class="sticky top-0 z-50 h-16 border-b border-hairline bg-canvas/80 backdrop-blur-md">
			<div class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
				<a href="/" class="flex items-center gap-2">
					<div class="h-6 w-6 bg-ink rounded-sm flex items-center justify-center">
						<div class="h-3 w-3 border-2 border-canvas rotate-45"></div>
					</div>
					<span class="text-sm font-semibold tracking-tight text-ink">Image Optimizer</span>
				</a>
				<div class="flex items-center gap-6">
					<div class="hidden sm:flex items-center gap-6">
						<a href="/about" class="text-xs font-medium text-mute hover:text-ink transition-colors">About</a>
						<a href="/privacy" class="text-xs font-medium text-mute hover:text-ink transition-colors">Privacy</a>
					</div>
					<div class="h-4 w-px bg-hairline hidden sm:block"></div>
					<div class="flex items-center gap-3">
						<button 
							id="theme-toggle"
							class="flex h-8 w-8 items-center justify-center rounded-geist border border-hairline bg-canvas text-ink shadow-v-1 transition-all hover:bg-canvas-soft-2"
							aria-label="Toggle dark mode"
						>
							<svg id="sun-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1m-16 0H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
							</svg>
							<svg id="moon-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
							</svg>
						</button>
						<button class="h-8 px-4 bg-ink text-canvas text-xs font-medium rounded-geist shadow-v-2 transition-all hover:opacity-90">
							Feedback
						</button>
					</div>
				</div>
			</div>
		</nav>

		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		
			window.localStorage.setItem('theme', theme);
		
			const handleToggleClick = () => {
				const element = document.documentElement;
				element.classList.toggle("dark");
		
				const isDark = element.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				updateIcons();
			}

			const updateIcons = () => {
				const isDark = document.documentElement.classList.contains("dark");
				document.getElementById('sun-icon').classList.toggle('hidden', !isDark);
				document.getElementById('moon-icon').classList.toggle('hidden', isDark);
			}
		
			document.getElementById("theme-toggle").addEventListener("click", handleToggleClick);
			updateIcons();
		</script>
		<main>
			<slot />
		</main>
		<footer class="border-t border-hairline bg-canvas py-12 mt-24">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
					<div class="flex items-center gap-2">
						<div class="h-5 w-5 bg-ink rounded-sm flex items-center justify-center scale-75">
							<div class="h-2.5 w-2.5 border-2 border-canvas rotate-45"></div>
						</div>
						<span class="text-xs font-medium text-mute">© 2026 imageoptmize.com</span>
					</div>
					<div class="flex gap-8">
						<a href="#" class="text-xs text-mute hover:text-ink">Terms</a>
						<a href="#" class="text-xs text-mute hover:text-ink">Privacy</a>
						<a href="#" class="text-xs text-mute hover:text-ink">Contact</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
