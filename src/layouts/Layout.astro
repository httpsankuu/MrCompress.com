		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		
			window.localStorage.setItem('theme', theme);
		
			const handleToggleClick = () => {
				const element = document.documentElement;
				element.classList.toggle("dark");
		
				const isDark = element.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				updateIcons();
			}

			const updateIcons = () => {
				const isDark = document.documentElement.classList.contains("dark");
				document.getElementById('sun-icon').classList.toggle('hidden', !isDark);
				document.getElementById('moon-icon').classList.toggle('hidden', isDark);
			}
		
			document.getElementById("theme-toggle").addEventListener("click", handleToggleClick);
			updateIcons();

			// Custom Language Selector Logic
			const langOptions = document.getElementById('lang-options');
			if (langOptions) {
				langOptions.addEventListener('click', (e) => {
					const button = e.target.closest('button');
					if (!button) return;

					const lang = button.getAttribute('data-lang');
					const langText = button.firstChild.textContent.trim();
					
					const triggerTranslation = () => {
						const googleSelect = document.querySelector('.goog-te-combo');
						if (googleSelect) {
							googleSelect.value = lang;
							googleSelect.dispatchEvent(new Event('change'));
							
							const currentLangDisplay = document.getElementById('current-lang');
							if (currentLangDisplay) {
								currentLangDisplay.textContent = langText;
							}
							return true;
						}
						return false;
					};

					// Set cookie with broad scope to ensure persistence
					const domain = window.location.hostname;
					const cookieValue = `/en/${lang}`;
					const expires = new Date();
					expires.setTime(expires.getTime() + (365 * 24 * 60 * 60 * 1000)); // 1 year
					
					document.cookie = `googtrans=${cookieValue}; expires=${expires.toUTCString()}; path=/; domain=${domain}`;
					document.cookie = `googtrans=${cookieValue}; expires=${expires.toUTCString()}; path=/`;

					if (!triggerTranslation()) {
						// If instant trigger fails, reload to apply cookie
						const currentLangDisplay = document.getElementById('current-lang');
						if (currentLangDisplay) {
							currentLangDisplay.textContent = langText;
						}
						window.location.reload();
					}
				});
			}

			// Persistent UI cleanup for Google Translate
			const cleanupGoogleUI = () => {
				const selectors = [
					'.goog-te-banner-frame', 
					'#goog-gt-tt', 
					'.goog-te-balloon-frame', 
					'.goog-te-menu-frame',
					'iframe[id*=":1.container"]',
					'iframe[id*=":0.container"]',
					'iframe[id*=":2.container"]',
					'iframe.goog-te-banner-frame',
					'.skiptranslate.goog-te-gadget',
					'.VIpgJm-Zp6pS-aZ2wYd-W79pY',
					'.goog-te-spinner-pos',
					'.goog-te-spinner',
					'.goog-te-gadget-icon',
					'#google_translate_element img',
					'.goog-te-menu-value img',
					'.goog-te-gadget-simple img'
				];
				selectors.forEach(s => {
					const el = document.querySelectorAll(s);
					el.forEach(item => {
						item.style.setProperty('display', 'none', 'important');
						item.style.setProperty('visibility', 'hidden', 'important');
						item.style.setProperty('opacity', '0', 'important');
						item.style.setProperty('pointer-events', 'none', 'important');
						item.style.setProperty('height', '0px', 'important');
						item.style.setProperty('width', '0px', 'important');
					});
				});
				if (document.body.style.top !== '0px') {
					document.body.style.setProperty('top', '0px', 'important');
				}
			};

			// Run cleanup very frequently initially, then slow down
			let cleanupInterval = setInterval(cleanupGoogleUI, 50);
			setTimeout(() => {
				clearInterval(cleanupInterval);
				setInterval(cleanupGoogleUI, 300);
			}, 5000);
			const observer = new MutationObserver(cleanupGoogleUI);
			observer.observe(document.documentElement, { attributes: true, childList: true, subtree: true });

			// On page load, sync the current language label
			window.addEventListener('load', () => {
				const getCookie = (name) => {
					const value = `; ${document.cookie}`;
					const parts = value.split(`; ${name}=`);
					if (parts.length === 2) return parts.pop().split(';').shift();
				};
				
				const googtrans = getCookie('googtrans');
				if (googtrans) {
					const langCode = googtrans.split('/').pop();
					const matchingBtn = document.querySelector(`#lang-options button[data-lang="${langCode}"]`);
					if (matchingBtn) {
						const langText = matchingBtn.firstChild.textContent.trim();
						const currentLangDisplay = document.getElementById('current-lang');
						if (currentLangDisplay) {
							currentLangDisplay.textContent = langText;
						}
					}
				}
			});
		</script>
		<main>
			<slot />
		</main>
		<footer class="border-t border-hairline bg-canvas py-16 mt-24">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
					<div class="col-span-1 md:col-span-2">
						<a href="/" class="flex items-center gap-2 mb-4">
							<img src="/favicon-96x96.png" alt="Logo" class="h-6 w-6 rounded-sm" />
							<span class="text-sm font-semibold tracking-tight text-ink">ImagNinja</span>
						</a>
						<p class="text-xs text-mute max-w-xs leading-relaxed">
							The fastest, most secure way to optimize your images. Everything happens locally in your browser. Private by design.
						</p>
					</div>
					<div>
						<h4 class="text-xs font-bold text-ink mb-4 uppercase tracking-wider">Product</h4>
						<ul class="space-y-3">
							<li><a href="/compress" class="text-xs text-mute hover:text-ink transition-colors">Compress Image</a></li>
							<li><a href="/convert" class="text-xs text-mute hover:text-ink transition-colors">Convert Format</a></li>
							<li><a href="/#faq" class="text-xs text-mute hover:text-ink transition-colors">FAQs</a></li>
						</ul>
					</div>
