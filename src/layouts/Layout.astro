			<div class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
				<a href="/" class="flex items-center gap-2">
					<img src="/favicon-96x96.png" alt="Logo" class="h-6 w-6 rounded-sm" />
